{
  "name": "@sugarat/vitepress-theme-vibework",
  "version": "0.1.0",
  "description": "VitePress theme for a works portfolio catalog. Chinese-first, Naive UI, SSG-ready.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ATQQ/vibe-works",
    "directory": "packages/theme"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./style.css": "./src/styles/index.css",
    "./config": {
      "types": "./src/config.ts",
      "import": "./dist/config.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./style.css": "./dist/styles/index.css",
      "./config": {
        "types": "./dist/config.d.ts",
        "import": "./dist/config.js"
      }
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && mkdist --src=src --dist=dist --ext=js --declaration",
    "typecheck": "vue-tsc --noEmit",
    "build:config": "node scripts/build-config.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "vitepress": "^1.6.0 || ^2.0.0-0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@css-render/vue3-ssr": "^0.15.14",
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "markdown-it-container": "^4.0.0",
    "naive-ui": "^2.43.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "esbuild": "^0.25.10",
    "mkdist": "^2.4.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitepress": "next",
    "vue": "^3.5.22",
    "vue-sfc-transformer": "^0.1.17",
    "vue-tsc": "^3.1.1"
  }
}
