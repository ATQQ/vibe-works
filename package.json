{
  "name": "vibe-works",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:theme": "pnpm --filter @sugarat/vitepress-theme-vibework build",
    "preview": "pnpm --filter web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "sync:updated": "node scripts/sync-updated.mjs",
    "try:create": "node scripts/try-create.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-template-version.mjs && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
